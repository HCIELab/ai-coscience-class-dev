# Copy to .env for local scripts only. .env is git-ignored; never commit a real key.
# A static site cannot read this file, and a key must never be baked into client-side JS.
# Labs that call an AI API do it with a key the student enters in the page (kept in their browser)
# or through a small server-side proxy, never from a key shipped with the site.
PARLEY_API_KEY=sk-parley-v1-replace-me
PARLEY_BASE_URL=https://parley.api.mit.edu/v1
PARLEY_ACCOUNT_ID=acc_replace-me
